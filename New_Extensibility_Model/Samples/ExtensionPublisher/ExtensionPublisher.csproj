<Project Sdk="Microsoft.VisualStudio.Sdk.Build/18.11.1098">

  <PropertyGroup>
    <TargetFrameworks>vs18_13</TargetFrameworks>
    <ExtensionType>VisualStudio.Extensibility</ExtensionType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="MyToolWindowContent.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MyToolWindowContent.xaml">
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyOutputToVsixPackageFolder" AfterTargets="Build">
    <ItemGroup>
      <VsixFiles Include="$(OutputPath)\*.vsix" />
    </ItemGroup>
  </Target>
</Project>
