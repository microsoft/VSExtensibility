<Project Sdk="Microsoft.VisualStudio.Sdk.Build/18.11.1098">
  <PropertyGroup>
    <TargetFrameworks>vs18_13</TargetFrameworks>
    <ExtensionType>VisualStudio.Extensibility</ExtensionType>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="MyToolWindowControl.xaml" />
    <EmbeddedResource Include="SettingsPreviewControl.xaml" />
    <Page Remove="MyToolWindowControl.xaml" />
    <Page Remove="SettingsPreviewControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
